// Prisma Schema for Generational Tree
// Database: Supabase (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// Table 1: Person
// ─────────────────────────────────────────────
model Person {
  id               Int      @id @default(autoincrement())
  salutation       String?  // e.g. "Shri", "Smt", "Late Shri"
  firstName        String   @map("first_name")
  middleName       String?  @map("middle_name")
  surname          String   @map("surname")
  displayName      String   @map("display_name")
  gender           String   // "Male" or "Female"
  generationNumber Int      @map("generation_number")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  parentOf         ParentChild[] @relation("ParentRelation")
  childOf          ParentChild[] @relation("ChildRelation")
  comments         Comment[]     @relation("CommentAbout")
  linkedComments   Comment[]     @relation("CommentLinkedPerson")

  @@map("person")
}

// ─────────────────────────────────────────────
// Table 2: ParentChild (join table)
// ─────────────────────────────────────────────
model ParentChild {
  id       Int @id @default(autoincrement())
  parentId Int @map("parent_id")
  childId  Int @map("child_id")

  // Foreign keys
  parent   Person @relation("ParentRelation", fields: [parentId], references: [id], onDelete: Cascade)
  child    Person @relation("ChildRelation", fields: [childId], references: [id], onDelete: Cascade)

  // Prevent duplicate parent-child pairs
  @@unique([parentId, childId])
  @@map("parent_child")
}

// ─────────────────────────────────────────────
// Table 3: Admin (people who may edit the tree)
// Exactly one owner (enforced by a partial unique index in enable-rls.sql);
// only the owner can create or remove admins.
// ─────────────────────────────────────────────
enum AdminRole {
  owner
  admin
}

model Admin {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String    @map("password_hash")
  role         AdminRole @default(admin)
  createdById  Int?      @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  resolved Comment[]

  @@map("admin")
}

// ─────────────────────────────────────────────
// Table 4: Comment (visitor notes about a person, reviewed by admins)
// ─────────────────────────────────────────────
enum CommentStatus {
  new
  resolved
  dismissed
}

// How the commenter connects to the tree
enum CommenterLink {
  self // they are in the tree
  ancestor // an ancestor of theirs is
  none // neither, or not sure
}

model Comment {
  id             Int           @id @default(autoincrement())
  personId       Int           @map("person_id")
  name           String
  phone          String
  link           CommenterLink
  linkedPersonId Int?          @map("linked_person_id")
  relation       String?
  message        String
  status         CommentStatus @default(new)
  adminNote      String?       @map("admin_note")
  resolvedById   Int?          @map("resolved_by_id")
  resolvedAt     DateTime?     @map("resolved_at") @db.Timestamptz
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  person       Person  @relation("CommentAbout", fields: [personId], references: [id], onDelete: Cascade)
  linkedPerson Person? @relation("CommentLinkedPerson", fields: [linkedPersonId], references: [id], onDelete: SetNull)
  resolvedBy   Admin?  @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([personId])
  @@index([linkedPersonId])
  @@index([resolvedById])
  @@index([status, createdAt])
  @@index([phone, createdAt])
  @@map("comment")
}
