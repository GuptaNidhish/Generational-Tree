# ─────────────────────────────────────────────
# Supabase PostgreSQL Connection Strings
# ─────────────────────────────────────────────
# Get these from: Supabase Dashboard → Connect → ORMs → Prisma
# Copy this file to .env and replace [YOUR-PASSWORD].

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only) — Prisma Client
DATABASE_URL="postgresql://postgres.yaerdbdcmbwyhigpooco:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler — Prisma CLI (db push / migrations)
DIRECT_URL="postgresql://postgres.yaerdbdcmbwyhigpooco:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────
# Admin sign-in
# ─────────────────────────────────────────────
# Signs admin session cookies. Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# ─────────────────────────────────────────────
# Cloudflare Turnstile (free "are you human" check on visitor comments)
# ─────────────────────────────────────────────
# Create a widget at https://dash.cloudflare.com → Turnstile, and put the
# site key in client/.env as VITE_TURNSTILE_SITE_KEY.
# Leave empty in development to skip the check, or use Cloudflare's test
# secret that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=""

# Set to 1 when running behind one reverse proxy (Render, Railway, Nginx…)
# so rate limits see each visitor's real IP address.
# TRUST_PROXY=1
