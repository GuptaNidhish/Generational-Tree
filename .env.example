# ─────────────────────────────────────────────
# Supabase PostgreSQL Connection Strings
# ─────────────────────────────────────────────
# Get these from: Supabase Dashboard → Connect → ORMs → Prisma
# Copy this file to .env and replace [PROJECT-REF], [REGION] and [YOUR-PASSWORD].

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only) — Prisma Client
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler — Prisma CLI (db push / migrations) and db:backup
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────
# Admin sign-in
# ─────────────────────────────────────────────
# Signs admin session cookies. Required in production, at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs every admin out.
SESSION_SECRET=""

# ─────────────────────────────────────────────
# Cloudflare Turnstile (free "are you human" check on visitor comments)
# ─────────────────────────────────────────────
# Create a widget at https://dash.cloudflare.com → Turnstile, and put the
# site key in client/.env as VITE_TURNSTILE_SITE_KEY (needed when building).
# Required in production. Leave empty in development to skip the check, or use
# Cloudflare's test secret that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=""

# Production refuses to start without TURNSTILE_SECRET_KEY. Set this to 1 only
# to run without the bot check on purpose.
# TURNSTILE_DISABLED=1

# ─────────────────────────────────────────────
# Running in production
# ─────────────────────────────────────────────
# NODE_ENV=production   turns on the startup checks, secure cookies, HSTS and request logs
# PORT=4000             most hosts set this for you

# Set to 1 when running behind one reverse proxy (Render, Railway, Nginx…)
# so rate limits see each visitor's real IP address. Production warns if unset.
# TRUST_PROXY=1

# Other sites allowed to call the API from a browser (comma-separated).
# Leave unset: the site itself is served from the same origin and needs none.
# CORS_ORIGINS=https://example.org

# Rate limits per visitor (defaults shown)
# RATE_LIMIT_API_PER_MIN=300
# RATE_LIMIT_LOGIN_PER_15MIN=10
# RATE_LIMIT_COMMENTS_PER_HOUR=5

# Log one line per API request outside production too
# LOG_REQUESTS=1
